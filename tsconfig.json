{
	"compilerOptions": {
		"rootDir": "./src",
		"outDir": "./dist",
		"module": "NodeNext",
		"target": "ES2022",
		"moduleResolution": "NodeNext",
		"esModuleInterop": true,
		"sourceMap": true,
		"declaration": true,
		"declarationMap": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"strict": true,
		"skipLibCheck": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*"],
	"exclude": [
		"node_modules",
		"dist",
		"prisma.config.ts",
		"jest.config.cjs",
		"src/__tests__"
	]
}
